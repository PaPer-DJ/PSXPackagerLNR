<Window x:Class="PSXPackagerGUI.LnrDiscSuiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSXPackagerLNR · Suite de discos"
        Width="1020" Height="770" MinWidth="800" MinHeight="610"
        WindowStartupLocation="CenterOwner" Closing="Window_OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="LnrAnalyzeButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="16" Height="16" Margin="0,0,6,0">
                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                             Stroke="#FF326A9C" StrokeThickness="1.8"/>
                    <Line X1="9.5" Y1="9.5" X2="15" Y2="15" Stroke="#FF326A9C"
                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Canvas>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrConvertButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 2,1 L 2,15 L 14,8 Z" Width="15" Height="16"
                      Fill="#FF168944" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrHelpButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="16" Height="16" Margin="0,0,6,0">
                    <Ellipse Stroke="#FF326A9C" StrokeThickness="1.6"/>
                    <TextBlock Text="i" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="#FF326A9C" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="LnrSuiteCenteredHeader" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LnrSuiteLeftHeader" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <DataTemplate x:Key="LnrSuiteNameCell">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="LnrSuiteSizeCell">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Stretch"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrSuiteStatusCell">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Stretch"
                           TextAlignment="Center" VerticalAlignment="Center"
                           ToolTip="{Binding Status}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrSuiteOutputCell">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding OutputCount}" HorizontalAlignment="Stretch"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="8" MinHeight="8"/>
            <RowDefinition Height="185" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Suite de discos · Conversiones adicionales" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="PS1: PBP → CHD / BIN+CUE / ISO limitado  ·  CHD → BIN+CUE (CD) / ISO (DVD)"
                       Foreground="#FF526278" Margin="0,4,0,0"/>
            <TextBlock Text="Los originales se conservan. Solo las conversiones que crean o extraen CHD necesitan CHDMAN (MAME)."
                       Foreground="#FF526278" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Conversión" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ModeBox" MinHeight="31"
                      SelectionChanged="Mode_OnChanged">
                <ComboBoxItem Content="PBP → CHD (PS1, un CHD por disco)" Tag="PBP2CHD"/>
                <ComboBoxItem Content="PBP → BIN/CUE (PS1, conserva pistas)" Tag="PBP2CUE"/>
                <ComboBoxItem Content="PBP → ISO (PS1, SOLO CD de datos MODE1)" Tag="PBP2ISO"/>
                <ComboBoxItem Content="CHD → BIN/CUE (CD: PS1, Saturn y PS2 CD)" Tag="CHD2CUE"/>
                <ComboBoxItem Content="CHD → ISO (DVD: PS2 DVD)" Tag="CHD2ISO"/>
            </ComboBox>
            <Button Grid.Column="2" x:Name="InfoButton" Content="Ayuda"
                    ContentTemplate="{StaticResource LnrHelpButtonTemplate}"
                    Margin="9,0,0,0" Click="Help_OnClick"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Carpeta origen" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="SourceBox" MinHeight="31"
                     VerticalContentAlignment="Center" KeyDown="Source_OnKeyDown"
                     ToolTip="Carpeta que contiene los archivos PBP o CHD"/>
            <Button Grid.Column="2" x:Name="BrowseButton" Content="Seleccionar..."
                    Margin="9,0,0,0" Click="Browse_OnClick"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="124"/>
                <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChdmanLabel" Text="CHDMAN" VerticalAlignment="Center"
                       ToolTip="Solo se necesita para PBP→CHD y CHD→BIN/CUE/ISO. PBP→BIN/CUE e ISO simple usan el motor original."/>
            <TextBox Grid.Column="1" x:Name="ChdmanBox" MinHeight="31"
                     VerticalContentAlignment="Center"
                     ToolTip="Ruta de chdman.exe. Puedes importarlo desde un ZIP o localizar el que ya tengas."/>
            <Button Grid.Column="2" x:Name="ImportChdmanButton" Content="Importar ZIP..."
                    Margin="9,0,0,0" Click="ImportChdman_OnClick"
                    ToolTip="Importa un chdman.exe de un ZIP que hayas descargado de MAME, Recalbox u OnionUI"/>
            <Button Grid.Column="3" x:Name="FindChdmanButton" Content="Localizar..."
                    Margin="9,0,0,0" Click="FindChdman_OnClick"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,7">
                <TextBlock Text="Archivos detectados" FontWeight="SemiBold" DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="CountLabel" Text="0 archivos" DockPanel.Dock="Left"
                           Margin="12,0,0,0" Foreground="#FF617184" VerticalAlignment="Center"/>
                <Button x:Name="ConvertButton" Content="Convertir lote"
                        ContentTemplate="{StaticResource LnrConvertButtonTemplate}"
                        Click="Convert_OnClick" DockPanel.Dock="Right"
                        Padding="12,6" Margin="9,0,0,0"/>
                <Button x:Name="AnalyzeButton" Content="Analizar"
                        ContentTemplate="{StaticResource LnrAnalyzeButtonTemplate}"
                        Click="Analyze_OnClick" DockPanel.Dock="Right" Padding="12,6"/>
            </DockPanel>
            <ListView Grid.Row="1" x:Name="JobsList"
                      SnapsToDevicePixels="True" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SizeChanged="JobsList_OnSizeChanged" Loaded="JobsList_OnLoaded">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Archivo origen" CellTemplate="{StaticResource LnrSuiteNameCell}"
                                        HeaderContainerStyle="{StaticResource LnrSuiteLeftHeader}" Width="395"/>
                        <GridViewColumn Header="Tamaño" CellTemplate="{StaticResource LnrSuiteSizeCell}"
                                        HeaderContainerStyle="{StaticResource LnrSuiteCenteredHeader}" Width="110"/>
                        <GridViewColumn Header="Estado" CellTemplate="{StaticResource LnrSuiteStatusCell}"
                                        HeaderContainerStyle="{StaticResource LnrSuiteCenteredHeader}" Width="185"/>
                        <GridViewColumn Header="Archivos producidos" CellTemplate="{StaticResource LnrSuiteOutputCell}"
                                        HeaderContainerStyle="{StaticResource LnrSuiteCenteredHeader}" Width="130"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <GridSplitter Grid.Row="5" Margin="0,3,0,0" Height="7"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                      Background="#FFDCE5EF" Cursor="SizeNS"
                      ToolTip="Arrastra para cambiar el tamaño del registro"/>

        <Grid Grid.Row="6" Margin="0,9,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Actividad y resultados" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" x:Name="AutoScrollCheck" Content="Seguir actividad"
                          IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center"
                          ToolTip="Desmarca para revisar mensajes anteriores sin saltar al final"/>
                <Button Grid.Column="2" Content="Limpiar registro" Click="ClearLog_OnClick"
                        Padding="9,4" Margin="0,0,7,0"
                        ToolTip="Vacía el registro visible de esta sesión; no borra archivos ni conversiones"/>
                <Button Grid.Column="3" Content="Copiar registro" Click="CopyLog_OnClick"
                        Padding="9,4" Margin="0,0,7,0"
                        ToolTip="Copia el registro de actividad al portapapeles"/>
                <Button Grid.Column="4" Content="Abrir salida" Click="OpenOutput_OnClick"
                        Padding="9,4" ToolTip="Abre la carpeta de salida del formato seleccionado"/>
            </Grid>
            <TextBox Grid.Row="1" x:Name="LogBox" FontFamily="Consolas" FontSize="12"
                     Background="#FF172434" Foreground="White" BorderThickness="0"
                     Padding="10" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     ToolTip="Registro de la sesión. Puedes ampliar este panel arrastrando el separador superior."/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="122"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
                <ProgressBar x:Name="BatchProgress" Height="12" Maximum="100"
                             Foreground="#FF168944"/>
                <TextBlock x:Name="ProgressLabel" Text="0/0 · sin iniciar" Margin="0,6,0,0"/>
                <TextBlock x:Name="OutputLabel"
                           Text="Se conservarán todos los PBP y CHD originales."
                           Foreground="#FF64748B" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False"
                    Click="Cancel_OnClick" Grid.Row="0" Grid.Column="1" Margin="12,0,0,0"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,9,0,0">
                <Button x:Name="CancelScheduledShutdownButton"
                        Content="Cancelar apagado programado" Visibility="Collapsed"
                        Click="CancelScheduledShutdown_OnClick" Margin="0,0,12,0" Padding="9,5"
                        ToolTip="Cancela la cuenta atrás local antes de solicitar el apagado normal de Windows"/>
                <CheckBox x:Name="ShutdownCheck" Content="Apagar equipo al finalizar el lote"
                          IsChecked="False" VerticalAlignment="Center"
                          ToolTip="Opcional y con confirmación. Solo tras conversiones correctas, sin fallos ni cancelación. Tienes 60 segundos para cancelar el apagado normal de Windows."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>