<Window x:Class="PSXPackagerGUI.LnrAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de PSXPackagerLNR" Width="650" Height="510"
        MinWidth="600" MinHeight="465" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF152438" CornerRadius="7"
                Padding="14" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Branding/lnr-mod-logo.png"
                       Width="380" Height="66" Stretch="Uniform"/>
                <TextBlock Text="Adaptación de interfaz y herramientas LaNaveRETRO"
                           FontSize="11" Foreground="#FFD2DCEB"
                           TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="PSXPackagerLNR" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionLabel" Text="Versión de desarrollo"
                       Foreground="#FF52667D" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Créditos del proyecto original" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF344559">
                PSXPackager: autor original David Khristepher Santos
                (copyright 2020, licencia MIT). Proyecto y mejoras mantenidos en el
                repositorio de RupertAvery y sus colaboradores. Esta edición LNR
                adapta la interfaz y añade herramientas, sin atribuirse la
                creación del programa original.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="#FF344559" Margin="0,10,0,0">
                Se conservan la licencia MIT y los avisos de autoría del proyecto.
                Esta adaptación se distribuye como fork independiente, sin afiliación
                oficial con el autor del software original.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="#FF344559" Margin="0,15,0,0">
                <Run FontWeight="SemiBold">¿Por qué compresión PBP nivel 3?</Run>
                <LineBreak/>
                Elección LNR basada en pruebas de carga en PSP original y en el
                análisis de SharpZipLib. Los detalles, parámetros y límites
                de la conclusión se explican en:
                <Hyperlink NavigateUri="https://github.com/PaPer-DJ/PSXPackagerLNR/blob/lnr/windows-chd-build/README.md#anexo-tecnico-lnr-nivel-3"
                           RequestNavigate="CompressionTechnical_OnRequestNavigate"
                           Foreground="#FF1766B0">Anexo técnico: nivel 3 y pruebas en PSP</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Proyecto original"
                    Click="Original_OnClick" Padding="12,8" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Fork LNR"
                    Click="Fork_OnClick" Padding="12,8"/>
            <Button Grid.Column="3" Content="Cerrar"
                    IsDefault="True" IsCancel="True" Click="Close_OnClick"/>
        </Grid>
    </Grid>
</Window>