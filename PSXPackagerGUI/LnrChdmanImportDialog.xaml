<Window x:Class="PSXPackagerGUI.LnrChdmanImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importación de CHDMAN de terceros"
        Width="680" Height="460" MinWidth="620" MinHeight="430"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="White" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Descargar e importar CHDMAN" FontSize="20"
                   FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#FF38465A"
                   Margin="0,0,0,13">
            Antes de seleccionar el ZIP, puedes abrir cualquiera de estas
            fuentes desde los enlaces siguientes. Se abrirán en tu navegador,
            sin cerrar este cuadro.
        </TextBlock>

        <Border Grid.Row="2" Background="#FFF3F7FB" CornerRadius="6"
                BorderBrush="#FFD8E1EB" BorderThickness="1" Padding="13,12"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,9">
                    <Hyperlink NavigateUri="https://wiki.recalbox.com/es/tutorials/utilities/rom-conversion/chdman"
                               RequestNavigate="SourceLink_OnRequestNavigate"
                               Foreground="#FF1668B2" ToolTip="Abrir el tutorial de Recalbox">Recalbox</Hyperlink>
                    <Run Text=" — Tutorial en castellano con CHDMAN y recursos para Windows."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,9">
                    <Hyperlink NavigateUri="https://onionui.github.io/docs/advanced/chdman"
                               RequestNavigate="SourceLink_OnRequestNavigate"
                               Foreground="#FF1668B2" ToolTip="Abrir la página de CHDMAN de OnionUI">OnionUI</Hyperlink>
                    <Run Text=" — Página de descarga y documentación de CHDMAN."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://www.mamedev.org/release.html"
                               RequestNavigate="SourceLink_OnRequestNavigate"
                               Foreground="#FF1668B2" ToolTip="Abrir las descargas oficiales de MAME">MAME</Hyperlink>
                    <Run Text=" — Distribución oficial recomendada; puede requerir extraer chdman.exe del paquete."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#FF38465A">
                CHDMAN pertenece al proyecto MAME y tiene su propia licencia.
                LaNaveRETRO no lo incluye ni lo descarga automáticamente.
                Selecciona únicamente paquetes de fuentes en las que confíes.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="#FF38465A" Margin="0,9,0,0">
                Al pulsar Sí, elegirás un ZIP que ya hayas descargado.
                La aplicación extraerá solamente chdman.exe a tu carpeta de usuario
                y lo utilizará cuando inicies una conversión que necesite CHDMAN.
                No se ejecutará durante la importación.
            </TextBlock>
        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="No" IsCancel="True"
                    Click="No_OnClick" Width="96" MinHeight="34"/>
            <Button DockPanel.Dock="Right" Content="Sí, importar ZIP"
                    IsDefault="True" Click="Import_OnClick"
                    Width="145" MinHeight="34" Margin="0,0,9,0"/>
        </DockPanel>
    </Grid>
</Window>