<Window x:Class="PSXPackagerGUI.LnrFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar carpeta de juegos CHD · PSXPackagerLNR"
        Width="970" Height="650" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFF8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Selecciona la carpeta que contiene tus CHD"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Puedes navegar por carpetas y ver los juegos que contienen antes de confirmar. No necesitas seleccionar un juego individual."
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF506177"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="PathBox" MinHeight="32"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"
                     KeyDown="PathBox_OnKeyDown"
                     ToolTip="Escribe o pega una ruta y pulsa Intro o el botón Ir"/>
            <Button Grid.Column="1" Content="Ir" Click="Go_OnClick"
                    Margin="0,0,8,0" MinHeight="32"/>
            <Button Grid.Column="2" x:Name="UpButton" Content="Subir" Click="Up_OnClick"
                    Margin="0,0,8,0" MinHeight="32"
                    ToolTip="Sube un nivel en el árbol de carpetas"/>
            <Button Grid.Column="3" Content="Explorar Windows..."
                    Click="NativeBrowse_OnClick" MinHeight="32"
                    ToolTip="También puedes usar el selector estándar de carpetas"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Subcarpetas (doble clic para entrar)"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Juegos CHD de esta carpeta"
                       FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*" MinWidth="330"/>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" x:Name="FolderList"
                      MouseDoubleClick="FolderList_OnDoubleClick"
                      BorderBrush="#FFCCD6E2" BorderThickness="1"
                      ToolTip="Haz doble clic sobre una subcarpeta para examinarla">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Carpeta" Width="290" DisplayMemberBinding="{Binding Name}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <ListView Grid.Column="2" x:Name="GameList"
                      BorderBrush="#FFCCD6E2" BorderThickness="1"
                      ToolTip="Lista informativa: se selecciona toda la carpeta, no un solo juego">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Archivo .CHD" Width="405" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Tamaño" Width="105" DisplayMemberBinding="{Binding Size}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusLabel" Margin="0,12,0,12"
                   TextWrapping="Wrap" Foreground="#FF45556B"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Se analizarán todos los archivos CHD de esta carpeta, sin entrar en subcarpetas."
                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF64748B"/>
            <Button Grid.Column="1" x:Name="SelectButton" Content="Usar esta carpeta"
                    Click="Select_OnClick" Padding="10,9" Margin="0,0,10,0"
                    IsDefault="False"/>
            <Button Grid.Column="2" Content="Cancelar" Click="Cancel_OnClick"
                    Padding="10,9" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>