<Window x:Class="PSXPackagerGUI.LnrFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar carpeta de juegos CHD · PSXPackagerLNR"
        Width="1130" Height="650" MinWidth="1030" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Background="#FFF8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitle" Text="Selecciona la carpeta que contiene tus CHD"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="HeaderDescription" Text="Puedes navegar por carpetas y ver los juegos que contienen antes de confirmar. No necesitas seleccionar un juego individual."
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF506177"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="PathBox" MinHeight="32"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"
                     KeyDown="PathBox_OnKeyDown"
                     ToolTip="Escribe o pega una ruta y pulsa Intro o el botón Entrar"/>
            <Button Grid.Column="1" x:Name="UpButton" Content="Atrás" Click="Up_OnClick"
                    Margin="0,0,8,0" MinHeight="32"
                    ToolTip="Volver a la carpeta superior"/>
            <Button Grid.Column="2" Content="Entrar" Click="Go_OnClick"
                    Margin="0,0,8,0" MinHeight="32"
                    ToolTip="Abrir la subcarpeta seleccionada o la ruta que hayas escrito arriba"/>
            <Button Grid.Column="3" Content="Explorar Windows..."
                    Click="NativeBrowse_OnClick" MinHeight="32"
                    ToolTip="También puedes usar el selector estándar de carpetas"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Subcarpetas (selecciona y pulsa Entrar, o doble clic)"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" x:Name="GamesHeading" Text="Juegos CHD de esta carpeta"
                       FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*" MinWidth="330"/>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" x:Name="FolderList"
                      MouseDoubleClick="FolderList_OnDoubleClick"
                      PreviewKeyDown="FolderList_OnPreviewKeyDown"
                      BorderBrush="#FFCCD6E2" BorderThickness="1"
                      ToolTip="Selecciona una carpeta y pulsa Entrar, o haz doble clic para examinarla">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Carpeta" Width="290" DisplayMemberBinding="{Binding Name}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <ListView Grid.Column="2" x:Name="GameList"
                      BorderBrush="#FFCCD6E2" BorderThickness="1"
                      ToolTip="Lista informativa: se selecciona toda la carpeta, no un solo juego">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Archivo .CHD" Width="405" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Tamaño" Width="105" DisplayMemberBinding="{Binding Size}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusLabel" Margin="0,12,0,12"
                   TextWrapping="Wrap" Foreground="#FF45556B"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock x:Name="ScopeDescription"
                           Text="Se analizarán todos los archivos CHD de esta carpeta, sin entrar en subcarpetas."
                           VerticalAlignment="Center" Foreground="#FF64748B"/>
                <CheckBox x:Name="IncludeSubfoldersCheck" Content="También subcarpetas"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="IncludeSubfolders_OnChanged"
                          Unchecked="IncludeSubfolders_OnChanged"
                          ToolTip="Busca también en las subcarpetas, excepto PBP, .tools y enlaces de carpetas. Los resultados se guardan en PBP respetando la estructura de subcarpetas; no se sobrescriben juegos con el mismo nombre."/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SelectButton" Content="Usar esta carpeta"
                    Click="Select_OnClick" Padding="10,9" Margin="0,0,10,0"
                    IsDefault="False"/>
            <Button Grid.Column="2" Content="Cancelar" Click="Cancel_OnClick"
                    Padding="10,9" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>