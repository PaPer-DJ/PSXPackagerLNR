<Window x:Class="PSXPackagerGUI.LnrBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSXPackagerLNR | CHD a PBP"
        Width="1020" Height="830" MinWidth="810" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing" Loaded="Window_OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="LnrGreen" Color="#FF168944"/>
        <SolidColorBrush x:Key="LnrRed" Color="#FFD32F2F"/>
        <SolidColorBrush x:Key="LnrAmber" Color="#FFB27A16"/>
        <SolidColorBrush x:Key="LnrBlue" Color="#FF205EA6"/>
        <!-- Small vector icons, rendered consistently without emoji fonts. -->
        <DataTemplate x:Key="LnrAnalyzeButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="16" Height="16" Margin="0,0,6,0">
                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                             Stroke="#FF326A9C" StrokeThickness="1.8"/>
                    <Line X1="9.5" Y1="9.5" X2="15" Y2="15" Stroke="#FF326A9C"
                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Canvas>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrConvertButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 2,1 L 2,15 L 14,8 Z" Width="15" Height="16"
                      Fill="#FF168944" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrHelpButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="16" Height="16" Margin="0,0,6,0">
                    <Ellipse Stroke="#FF326A9C" StrokeThickness="1.6"/>
                    <TextBlock Text="i" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Foreground="#FF326A9C" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrSuiteButtonTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M 13,5 C 10,1 4,1 2,5 M 2,5 L 2,1 M 2,5 L 6,5 M 3,11 C 6,15 12,15 14,11 M 14,11 L 14,15 M 14,11 L 10,11"
                      Width="16" Height="16" Stroke="#FF168944" StrokeThickness="1.65"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform" Fill="Transparent" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LnrGameNameTemplate">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DataTemplate>
        <Style x:Key="LnrCenteredColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="LnrDiscCountTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding DiscCount}" HorizontalAlignment="Center"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrOriginTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Origin}" HorizontalAlignment="Center"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrChdSizeTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding SourceSizeText}" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           ToolTip="Tamaño total de los CHD de origen; en juegos multidisco se suman todos"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrPbpSizeTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding OutputSizeText}" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           ToolTip="Tamaño del PBP generado o, si ya existía, del archivo del destino"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrVariationTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding VariationText}" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{Binding VariationBrush}"
                           ToolTip="{Binding VariationTooltip}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrElapsedTemplate">
            <Grid HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding ElapsedText}" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           ToolTip="Tiempo transcurrido en la conversión de este juego"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LnrStatusTemplate">
            <!-- Grid stretches to fill the entire status column.
                 A StackPanel shrank to text width and made the bar tiny. -->
            <Grid HorizontalAlignment="Stretch" Margin="3,1,3,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="○" FontSize="14"
                               Foreground="#FF8792A0" FontWeight="Bold"
                               VerticalAlignment="Center" Width="23"/>
                    <TextBlock x:Name="StatusText" Text="{Binding DisplayStatus}" ToolTip="{Binding DisplayStatus}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Row="1" x:Name="ProgressDetails" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" Margin="9,4,5,2" Height="13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="10" Margin="0,1,7,0"
                                 Minimum="0" Maximum="100" Foreground="{StaticResource LnrGreen}"
                                 Value="{Binding ProgressPercent}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}"
                               FontSize="11" Foreground="#FF49586B"
                               VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Convirtiendo">
                    <Setter TargetName="ProgressDetails" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StatusIcon" Property="Text" Value="▶"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource LnrBlue}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LnrBlue}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completado">
                    <Setter TargetName="StatusIcon" Property="Text" Value="✔"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource LnrGreen}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LnrGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                    <Setter TargetName="StatusIcon" Property="Text" Value="✖"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource LnrRed}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LnrRed}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Saltado / Ya existe">
                    <Setter TargetName="StatusIcon" Property="Text" Value="⚠"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource LnrAmber}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LnrAmber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                    <Setter TargetName="StatusIcon" Property="Text" Value="✖"/>
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource LnrRed}"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LnrRed}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="115"/>
            <RowDefinition Height="12"/>
            <RowDefinition x:Name="LogPanelRow" Height="200" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="165"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="CHD → PBP por lotes" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Conversión directa, sin CHDMAN ni archivos BIN/CUE intermedios."
                           Foreground="#FF5A6776" Margin="0,4,0,0"/>
                <TextBlock Text="Basado en PSXPackager de RupertAvery y colaboradores · Adaptación LaNaveRETRO."
                           FontSize="11" Foreground="#FF5A6776" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Click="LnrAbout_OnClick"
                    ToolTip="Créditos, autoría y licencia"
                    Background="Transparent" BorderThickness="0" Padding="3" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Width="152" Height="35" Stretch="Uniform"
                           Source="pack://application:,,,/Branding/lnr-mod-logo.png"/>
                    <TextBlock Text="Créditos y licencia"
                               TextAlignment="Center" FontSize="10"
                               Foreground="#FF607084" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Carpeta CHD" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="SourceBox" VerticalContentAlignment="Center"
                     MinHeight="30" Margin="0,0,10,0"
                     KeyDown="SourceBox_OnKeyDown" LostKeyboardFocus="SourceBox_OnLostKeyboardFocus"
                     ToolTip="Selecciona una carpeta o pega aquí su ruta y pulsa Intro"/>
            <Button Grid.Column="2" x:Name="BrowseButton" Content="Ver carpetas..."
                    Click="Browse_OnClick" MinHeight="30"/>
        </Grid>

        <Border Grid.Row="2" Background="#FFF2F4F7" BorderBrush="#FFDCE2E9"
                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Multidisco" VerticalAlignment="Center" Margin="0,0,9,0" ToolTip="Discos separados: un PBP por CHD. Unidos: un PBP por juego usando un M3U o la numeración de discos."/>
                <ComboBox Grid.Column="1" x:Name="ModeCombo" SelectedIndex="0" SelectionChanged="ModeCombo_OnSelectionChanged" ToolTip="El modo unido requiere que el emulador admita cambiar de disco"
                          VerticalAlignment="Center" MinHeight="30">
                    <ComboBoxItem Content="Separados (1:1)"/>
                    <ComboBoxItem Content="Unidos (M3U)"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="Compresión" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox Grid.Column="4" x:Name="LevelCombo" SelectedIndex="1"
                          ToolTip="Nivel 3 recomendado por LNR: compromiso entre tamaño de PBP y velocidad de CREACIÓN. SharpZipLib 1.4.2 comprime con búsqueda rápida en niveles 1 a 4; en 5 a 9 usa búsqueda más exhaustiva. Esto NO significa que la consola reproduzca más rápido ni garantiza evitar tirones. El PSXPackager original utiliza 5."
                          VerticalAlignment="Center" MinHeight="30">
                    <ComboBoxItem Content="1 - Ligera (rápida)" Tag="1"/>
                    <ComboBoxItem Content="3 - Equilibrada (LNR)" Tag="3"/>
                    <ComboBoxItem Content="5 - Estándar original" Tag="5"/>
                    <ComboBoxItem Content="9 - Máxima" Tag="9"/>
                </ComboBox>
                <Button Grid.Column="6" x:Name="ScanButton" Content="Analizar"
                        ContentTemplate="{StaticResource LnrAnalyzeButtonTemplate}"
                        Click="Scan_OnClick" Margin="0,0,8,0" MinHeight="31"/>
                <Button Grid.Column="7" x:Name="RunButton" Content="Convertir"
                        ContentTemplate="{StaticResource LnrConvertButtonTemplate}"
                        Click="Run_OnClick" MinHeight="31"/>
                <DockPanel Grid.Row="1" Grid.ColumnSpan="8" Margin="0,11,0,0"
                           LastChildFill="False">
                    <Button DockPanel.Dock="Right" x:Name="SuiteButton"
                            Content="Suite CD / CHD / ISO" Padding="10,5"
                            ContentTemplate="{StaticResource LnrSuiteButtonTemplate}"
                            Click="Suite_OnClick"
                            ToolTip="Otras conversiones: PBP→CHD, CHD→BIN/CUE y CHD→ISO"/>
                    <Button DockPanel.Dock="Right" x:Name="HelpButton"
                            Content="Ayuda y opciones" Padding="10,5" Margin="0,0,8,0"
                            ContentTemplate="{StaticResource LnrHelpButtonTemplate}"
                            Click="Help_OnClick"
                            ToolTip="Explicación de todas las opciones, seguridad y objetivos del fork LNR"/>
                    <CheckBox DockPanel.Dock="Left" x:Name="DeleteChdCheck"
                              IsChecked="False" VerticalAlignment="Center"
                              Checked="DeleteChd_OnChanged" Unchecked="DeleteChd_OnChanged"
                              FontWeight="SemiBold"
                              Content="Eliminar .CHD convertidos (irreversible)"
                              ToolTip="DESACTIVADO por defecto. Solo borra los CHD de conversiones nuevas terminadas y verificadas básicamente; nunca los de PBP existentes, errores ni cancelaciones."/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                <TextBlock Text="Juegos CHD detectados" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="0 trabajos"
                           HorizontalAlignment="Right" Margin="14,0,0,0"/>
            </DockPanel>
            <ListView Grid.Row="1" x:Name="JobList" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      SizeChanged="JobList_OnSizeChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nombre PBP" CellTemplate="{StaticResource LnrGameNameTemplate}" Width="232"/>
                        <GridViewColumn Header="Discos" CellTemplate="{StaticResource LnrDiscCountTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="56"/>
                        <GridViewColumn Header="Origen" CellTemplate="{StaticResource LnrOriginTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="76"/>
                        <GridViewColumn Header="CHD" CellTemplate="{StaticResource LnrChdSizeTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="101"/>
                        <GridViewColumn Header="PBP" CellTemplate="{StaticResource LnrPbpSizeTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="101"/>
                        <GridViewColumn Header="Variación" CellTemplate="{StaticResource LnrVariationTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="116"/>
                        <GridViewColumn Header="Tiempo" CellTemplate="{StaticResource LnrElapsedTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="68"/>
                        <GridViewColumn Header="Estado / Progreso" CellTemplate="{StaticResource LnrStatusTemplate}"
                                        HeaderContainerStyle="{StaticResource LnrCenteredColumnHeader}" Width="220"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <GridSplitter Grid.Row="4" Height="12" Margin="0,0,0,0"
                      Background="#FFD2DAE5" VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" Cursor="SizeNS"
                      ToolTip="Arrastra hacia arriba o abajo para cambiar el tamaño del registro">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="#FFB4C0D0" BorderThickness="0,1" CornerRadius="2">
                        <TextBlock Text="↕" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF4A5A6D"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Actividad y resultados" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" x:Name="AutoScrollCheck" Content="Seguir actividad"
                          IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"
                          ToolTip="Desmarca para revisar mensajes anteriores sin que el registro salte al final"/>
                <Button Grid.Column="2" x:Name="ClearLogButton" Content="Limpiar registro"
                        Click="ClearLog_OnClick" Padding="12,5" Margin="0,0,8,0"
                        ToolTip="Vacía el registro visible y el historial de esta sesión. No borra informes guardados, juegos ni resultados."/>
                <Button Grid.Column="3" x:Name="CopyLogButton" Content="Copiar registro"
                        Click="CopyLog_OnClick" Padding="12,5" Margin="0,0,8,0"
                        ToolTip="Copia los mensajes visibles y acumulados desde la última limpieza"/>
                <Button Grid.Column="4" x:Name="OpenPbpButton" Content="Abrir carpeta PBP"
                        Click="OpenPbp_OnClick" Padding="12,5"
                        ToolTip="Abre la carpeta de juegos PBP convertidos en el Explorador de Windows"/>
            </Grid>
            <TextBox Grid.Row="1" x:Name="OutputBox" FontFamily="Consolas" FontSize="12.5"
                     IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#FF192431" Foreground="#FFF2F7FD" BorderThickness="0"
                     Padding="12" VerticalContentAlignment="Top"
                     ToolTip="Registro de la sesión. Puedes ampliar este panel arrastrando el separador superior."/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="BatchPercentLabel"
                               Text="Avance del lote: 0 % (0/0)"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" x:Name="EtaLabel"
                               Text="Tiempo restante: sin calcular"
                               Foreground="#FF546679" Margin="14,0,0,0"
                               ToolTip="Estimación orientativa a partir de las conversiones completadas y los tamaños CHD; puede variar mucho según el juego."/>
                </Grid>
                <ProgressBar x:Name="WorkProgress" Height="12" Minimum="0" Maximum="100"
                             Foreground="{StaticResource LnrGreen}"/>
                <TextBlock x:Name="SummaryLabel" Margin="0,6,0,0"
                           Text="Los CHD originales permanecen intactos · Destino: subcarpeta PBP."/>
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="1" x:Name="CancelButton" Content="Cancelar"
                    Click="Cancel_OnClick" Margin="12,0,0,0" IsEnabled="False"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelScheduledShutdownButton"
                        Content="Cancelar apagado programado"
                        Visibility="Collapsed" Click="CancelScheduledShutdown_OnClick"
                        Margin="0,0,12,0" Padding="9,5"
                        ToolTip="Cancela la cuenta atrás local antes de solicitar el apagado normal de Windows"/>
                <CheckBox x:Name="ShutdownCheck"
                          Content="Apagar equipo al finalizar el lote"
                          IsChecked="False" VerticalAlignment="Center"
                          ToolTip="Desactivado por defecto. Solo se activa con confirmación y si al menos un juego acaba sin errores ni cancelación. La app concede 60 segundos para cancelar antes de solicitar un apagado normal sin forzar programas abiertos."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>