<Window x:Class="PSXPackagerGUI.LnrBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSXPackagerLNR | CHD a PBP" Width="940" Height="720"
        MinWidth="750" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="CHD → PBP por lotes" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Conversión directa sin CHDMAN ni BIN/CUE intermedios."
                       Foreground="#FF5A6776" Margin="0,4,0,0"/>
            <TextBlock Text="PSXPackager original: RupertAvery y colaboradores. Herramientas de flujo LNR: LaNaveRETRO."
                       FontSize="11" Foreground="#FF5A6776" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Carpeta CHD" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="SourceBox" VerticalContentAlignment="Center"
                     MinHeight="30" Margin="0,0,10,0"/>
            <Button Grid.Column="2" x:Name="BrowseButton" Content="Examinar..."
                    Click="Browse_OnClick" MinHeight="30"/>
        </Grid>

        <Border Grid.Row="2" Background="#FFF2F4F7" BorderBrush="#FFDCE2E9"
                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Multidisco" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox Grid.Column="1" x:Name="ModeCombo" SelectedIndex="0"
                          VerticalAlignment="Center" MinHeight="30">
                    <ComboBoxItem Content="Separados (1:1)"/>
                    <ComboBoxItem Content="Unidos (M3U)"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="Compresión" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox Grid.Column="4" x:Name="LevelCombo" SelectedIndex="1"
                          VerticalAlignment="Center" MinHeight="30">
                    <ComboBoxItem Content="1 - Mínima" Tag="1"/>
                    <ComboBoxItem Content="5 - Normal" Tag="5"/>
                    <ComboBoxItem Content="9 - Máxima" Tag="9"/>
                </ComboBox>
                <Button Grid.Column="6" x:Name="ScanButton" Content="Analizar"
                        Click="Scan_OnClick" Margin="0,0,6,0" MinHeight="31"/>
                <Button Grid.Column="7" x:Name="RunButton" Content="Convertir"
                        Click="Run_OnClick" MinHeight="31"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Juegos detectados" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Text="0 trabajos"
                           HorizontalAlignment="Right" Margin="14,0,0,0"/>
            </DockPanel>
            <ListView Grid.Row="1" x:Name="JobList" ItemsSource="{Binding Jobs}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nombre PBP" DisplayMemberBinding="{Binding Name}" Width="435"/>
                        <GridViewColumn Header="Discos" DisplayMemberBinding="{Binding DiscCount}" Width="65"/>
                        <GridViewColumn Header="Origen" DisplayMemberBinding="{Binding Origin}" Width="100"/>
                        <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding Status}" Width="175"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Actividad y resultados" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="OutputBox" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#FF192431" Foreground="White" BorderThickness="0"
                     Padding="10"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ProgressBar x:Name="WorkProgress" Height="12" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="SummaryLabel" Margin="0,6,0,0"
                           Text="Los CHD originales no se modifican. Salida: carpeta PBP."/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CancelButton" Content="Cancelar"
                    Click="Cancel_OnClick" Margin="12,0,0,0" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>